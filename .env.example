# .env.example
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/nummo.sqlite
DEFAULT_ACCOUNT_NAME=Compte principal

# Future intégration Kyros SSO — laisser AUTH_PROVIDER=local tant que non configuré.
AUTH_PROVIDER=local
LOCAL_AUTH_USERNAME=gestionnaire
# Laisser vide pour conserver le mode local sans écran bloquant.
LOCAL_AUTH_PASSWORD=
# Obligatoire si LOCAL_AUTH_PASSWORD est défini (32 caractères aléatoires minimum).
SESSION_SECRET=
KYROS_SSO_VERSION=4.4.0
KYROS_EDITION=standard
KYROS_APPLICATION_SCOPE=standard
KYROS_BASE_URL=
KYROS_AUTHORIZE_URL=
KYROS_TOKEN_URL=
KYROS_REVOKE_URL=
KYROS_CALLBACK_URL=http://localhost:3000/auth/callback
KYROS_CLIENT_ID=
KYROS_CLIENT_SECRET=
KYROS_JWT_SECRET=
KYROS_ISSUER=kyros
KYROS_AUDIENCE=kyros-modules
KYROS_RESOURCE_AUDIENCE=kyros:sso:nummo
KYROS_REQUESTED_SCOPE=profile email
KYROS_REQUIRED_SCOPES=profile email
