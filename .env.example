# .env.example
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/nummo.sqlite
DEFAULT_ACCOUNT_NAME=Compte principal

# Nummo délègue la connexion à Kyros. Sans configuration Kyros, le registre reste verrouillé.
AUTH_PROVIDER=kyros
KYROS_SSO_VERSION=4.4.0
KYROS_EDITION=standard
KYROS_APPLICATION_SCOPE=standard
KYROS_BASE_URL=
KYROS_AUTHORIZE_URL=
KYROS_TOKEN_URL=
KYROS_REVOKE_URL=
KYROS_CALLBACK_URL=http://localhost:3000/auth/callback
KYROS_CLIENT_ID=
KYROS_CLIENT_SECRET=
KYROS_JWT_SECRET=
KYROS_ISSUER=kyros
KYROS_AUDIENCE=kyros-modules
KYROS_RESOURCE_AUDIENCE=kyros:sso:nummo
KYROS_REQUESTED_SCOPE=profile email
KYROS_REQUIRED_SCOPES=profile email
